# Optional hosted Ask AI via the shared inference service.
# Inference Bridge works without these. Copy to .env.local for local use.
# Server-only: never prefix settings or credentials with VITE_.

# Config in both Preview and Production:
INFERENCE_FALLBACK_ENABLED=true
SHARED_INFERENCE_PROVIDER=replit
REPLIT_INFERENCE_MODEL=google/gemma-4-26b-a4b-it
SHARED_INFERENCE_URL=https://ipa-inference-fallback-api.vercel.app/api/inference

# Secret in both Preview and Production; use the existing staged credentials:
SHARED_INFERENCE_APP_SECRET=
SHARED_INFERENCE_REPLIT_API_KEY=

# Other supported shared providers use backend-owned model defaults.
# Set SHARED_INFERENCE_PROVIDER=ollama or gemini and its matching Secret:
# SHARED_INFERENCE_OLLAMA_API_KEY=
# SHARED_INFERENCE_GEMINI_API_KEY=
# Optional Config overrides for those shared providers:
# OLLAMA_MODEL=gemma4:cloud
# GEMINI_MODEL=gemma-4-31b-it
# Gemini web search requires separate selected-model validation before opt-in:
# SHARED_INFERENCE_GEMINI_SEARCH_ENABLED=false

# A separately running local shared API may listen on port 3001:
# SHARED_INFERENCE_URL=http://127.0.0.1:3001/api/inference
# Local HTTP is rejected in deployed Preview/Production.
# INFERENCE_FALLBACK_ENABLED=false disables hosted inference without affecting IPA.
