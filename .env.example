# Optional hosted Ask AI fallback; Inference Bridge works without these.
# Copy this file to .env.local, or set the values in the Vercel project.
# Server-only: never prefix credentials with VITE_.
OLLAMA_API_KEY=
INFERENCE_PROVIDER=ollama

# Direct requests go to https://ollama.com/api, with no local Ollama required.
# gemma4:cloud is mapped to the direct API tag gemma4:31b.
# OLLAMA_MODEL=gemma4:cloud
# INFERENCE_FALLBACK_ENABLED=true
# INFERENCE_CLIENT_DAILY_LIMIT=50

# Per-process limits. Attempts count even if Ollama fails; search/tool calls
# also count toward the provider request limit. These are app policy defaults,
# not published Ollama plan limits. Multiple Vercel instances do not share them.
# OLLAMA_CLIENT_REQUESTS_PER_MINUTE=5
# OLLAMA_REQUESTS_PER_MINUTE=20
# OLLAMA_MAX_CONCURRENT=2

# To switch back, set INFERENCE_PROVIDER=gemini and keep an independent key.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemma-4-31b-it
# Legacy INFERENCE_API_KEY is still accepted for Gemini only.
# INFERENCE_MODEL overrides the selected provider's default if explicitly selected.

# Optional shared route. Unset/false keeps the independent direct configuration.
# Replit is shared-only and never inherits INFERENCE_MODEL or legacy keys.
# SHARED_INFERENCE_ENABLED=true
# SHARED_INFERENCE_PROVIDER=replit
# REPLIT_INFERENCE_MODEL=google/gemma-4-26b-a4b-it
# SHARED_INFERENCE_URL=https://ipa-inference-fallback-api.vercel.app/api/inference
# SHARED_INFERENCE_APP_SECRET=
# SHARED_INFERENCE_REPLIT_API_KEY=
# SHARED_INFERENCE_OLLAMA_API_KEY=
# SHARED_INFERENCE_GEMINI_API_KEY=
# Gemini search stays off until separately validated for its selected model.
# SHARED_INFERENCE_GEMINI_SEARCH_ENABLED=false
# For a separate local shared service, use http://127.0.0.1:3001/api/inference.
